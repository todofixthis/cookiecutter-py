# https://docs.github.com/en/actions/automating-builds-and-tests/building-and-testing-python
name: CI

on:
  push: ~

permissions:
  contents: read

# Every uv command here leaves out the default `dev` group, whose tooling
# (autohooks → pontos → lxml) can lack wheels for a new Python. A flag on
# `uv sync` alone isn't enough: each `uv run` would install `dev` again.
env:
  UV_NO_DEFAULT_GROUPS: "1"

jobs:
  test:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        python-version:
          # Note: Use quotes to avoid float cast - especially important if the
          # version number ends with 0!
          - "[[ python_version ]]"
          - "[[ python_major ]].[[ python_minor | int - 1 ]]"
          - "[[ python_major ]].[[ python_minor | int - 2 ]]"

    steps:
      - name: Clone repo
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - name: Install uv
        uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2 # v10.3.3
      - name: Set up Python ${{ matrix.python-version }}
        uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0 # v7.1.0
        with:
          python-version: ${{ matrix.python-version }}
      - name: Install dependencies
        run: uv sync --group ci
      - name: Run tests
        run: uv run pytest

  type-check:
    runs-on: ubuntu-latest

    steps:
      - name: Clone repo
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - name: Install uv
        uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2 # v10.3.3
      - name: Set up Python
        uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0 # v7.1.0
        with:
          python-version: "[[ python_version ]]"
      - name: Install dependencies
        run: uv sync --group ci
      - name: Type checking
        run: uv run mypy src test

  # The pre-commit hook lints and formats too, but a commit made without it (a
  # bare `git commit`, GitHub's web editor, a Renovate PR) skips that.
  lint:
    runs-on: ubuntu-latest

    steps:
      - name: Clone repo
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - name: Install uv
        uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2 # v10.3.3
      - name: Set up Python
        uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0 # v7.1.0
        with:
          python-version: "[[ python_version ]]"
      - name: Install dependencies
        run: uv sync --group ci
      - name: Lint
        run: uv run ruff check
      - name: Check formatting
        run: uv run black --check .

  docs:
    runs-on: ubuntu-latest

    steps:
      - name: Clone repo
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - name: Install uv
        uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2 # v10.3.3
      - name: Set up Python
        uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0 # v7.1.0
        with:
          python-version: "[[ python_version ]]"
      - name: Install dependencies
        run: uv sync --group ci
      - name: Check docs build
        run: |
          cd docs
          mkdir -p _static
          uv run make html

  # The phx plugin's hooks check ADRs in Claude Code sessions but never block,
  # so this is the only check a commit made elsewhere meets (ADR 009 in
  # todofixthis/cookiecutter-py forbids a repo-local copy of the tool). Renovate
  # bumps the pinned release here and in AGENTS.md together; keep the trailing
  # version comment it matches on.
  adrs:
    runs-on: ubuntu-latest

    steps:
      - name: Clone repo
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - name: Install uv
        uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2 # v10.3.3
      - name: Check ADRs
        run: uvx --from 'git+https://github.com/todofixthis/phx-claude-siat@0725567cec6bab6a227c2a3d569e64c226c33a4e#subdirectory=skills/writing-adrs' phx-adr check # 8.1.0

  # Fails while this project supports an older Python range than the
  # template's policy, as a nudge to rotate with the `rotate-python-versions`
  # skill, which also removes compat code no tool can (ADR 015 in
  # todofixthis/cookiecutter-py). `gate` tolerates its failure, so it goes red
  # on every PR until the rotation lands but never blocks a merge.
  python-policy:
    runs-on: ubuntu-latest

    steps:
      - name: Compare python_version with the template's policy
        run: |
          project="[[ python_version ]]"
          policy="[[ python_policy ]]"
          if [ "${project#*.}" -lt "${policy#*.}" ]; then
            echo "::error::❌ python_version is ${project}, behind the template's policy of ${policy}: rotate with the rotate-python-versions skill."
            exit 1
          fi
          echo "✅ python_version ${project} meets the template's policy of ${policy}."

  # The single required status check. Depending on every job here collapses
  # their results into one, so branch protection requires only `gate`. Every
  # job must succeed, except that `python-policy` may fail, being a nudge. A
  # skipped job fails it, so a job silently skipped cannot pass unnoticed.
  gate:
    needs: [adrs, docs, lint, python-policy, test, type-check]
    if: always()
    runs-on: ubuntu-latest

    steps:
      - name: Fail if any check did not succeed
        env:
          NEEDS: ${{ toJSON(needs) }}
        run: |
          failed="$(jq -r 'to_entries[] | select(.value.result != "success") | select(.key != "python-policy" or .value.result != "failure") | "\(.key): \(.value.result)"' <<< "$NEEDS")"
          if [ -n "$failed" ]; then
            echo "❌ Checks that did not succeed:"
            echo "$failed"
            exit 1
          fi
          echo "✅ Every check succeeded."
