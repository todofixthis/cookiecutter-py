[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "[[ pypi_project_name ]]"
dynamic = ["version"]
description = "[[ project_short_description ]]"
authors = [{ name = "[[ author_name ]]", email = "[[ author_email ]]" }]
requires-python = ">=[[ python_major ]].[[ python_minor | int - 2 ]]"
readme = "README.rst"
license = "MIT"

# :see: https://pypi.org/classifiers/
keywords = [
]

# Leave out `Development Status`: the version's pre-release segment states it,
# and a hand-kept classifier goes stale (see
# https://github.com/todofixthis/cookiecutter-py/blob/main/docs/adr/023-leave-the-development-status-classifier-out-of-generated-projects.md).
classifiers = [
]

[project.urls]
Repository = "https://github.com/[[ github_username ]]/[[ github_project_name ]]"
Documentation = "https://[[ readthedocs_slug ]].readthedocs.io/"
Changelog = "https://github.com/[[ github_username ]]/[[ github_project_name ]]/releases"
Issues = "https://github.com/[[ github_username ]]/[[ github_project_name ]]/issues"

[dependency-groups]
# I'm only one person, so to keep from getting overwhelmed, I'm only committing
# to supporting the 3 most recent versions of Python (see
# https://github.com/todofixthis/cookiecutter-py/blob/main/docs/adr/015-propagate-template-changes-with-copier-and-rotate-python-from-agent-sessions.md).
dev = [
    "autohooks>=26,<27",
    "autohooks-plugin-black>=23,<24",
    "autohooks-plugin-mypy>=23,<24",
    "autohooks-plugin-pytest>=23,<24",
    "autohooks-plugin-ruff>=25,<26",
    "mypy>=2,<3",
    "pytest>=9,<10",
[%- if docs_site %]
    "sphinx>=9,<10",
    "sphinx_rtd_theme>=3.1,<4",
[%- endif %]
    "tox>=4,<5",
    "tox-uv>=1,<2",
]

# Used by GitHub Actions[% if docs_site %] and ReadTheDocs[% endif %].
ci = [
    "black>=26,<27",
    "mypy>=2,<3",
    "pytest>=9,<10",
    "ruff>=0.17,<0.18",
[%- if docs_site %]
    "sphinx>=9,<10",
    "sphinx_rtd_theme>=3.1,<4",
[%- endif %]
    "tox-uv>=1,<2",
]

[tool.autohooks]
mode = "pythonpath"
# Comment on an entry here, above `pre-commit`, never inside the array:
# `autohooks activate --force` rewrites the array sorted onto one line,
# dropping any comment inside it. Hooks run in list order, but that sort
# discards the order, so no hook may rely on running before another.
[%- if docs_site %]
#
# `docs_build` runs a strict, full-reread Sphinx build on staged docs and
# docstring changes (see
# https://github.com/todofixthis/cookiecutter-py/blob/main/docs/adr/020-fail-generated-docs-builds-on-sphinx-warnings-in-ci-and-before-commit.md)
# — removing it leaves a docs warning to CI, a push later.
[%- endif %]
pre-commit = [
    "autohooks.plugins.black",
    "autohooks.plugins.mypy",
    "autohooks.plugins.pytest",
    "autohooks.plugins.ruff",
[%- if docs_site %]
    "docs_build",
[%- endif %]
]

[tool.black]
# Explicit, because black otherwise infers every version `requires-python`
# allows, including ones newer than the running interpreter can parse.
target-version = [
    "py[[ python_major ]][[ python_minor ]]",
    "py[[ python_major ]][[ python_minor | int - 1 ]]",
    "py[[ python_major ]][[ python_minor | int - 2 ]]",
]

[tool.hatch.build.targets.sdist]
include = [
    "src/[[ package_name ]]",
    "LICENCE.txt",
[%- if docs_site %]
    "docs",
[%- endif %]
    "test",
]
[%- if docs_site %]
exclude = ["docs/_build"]
[%- endif %]

[tool.hatch.build.targets.wheel]
include = ["src/[[ package_name ]]"]
[%- if docs_site %]
exclude = ["docs/_build"]
[%- endif %]

[tool.hatch.build.targets.wheel.sources]
"src/[[ package_name ]]" = "[[ package_name ]]"

[tool.hatch.version]
path = "src/[[ package_name ]]/__init__.py"

[tool.mypy]
strict = true

[tool.pytest.ini_options]
testpaths = ["test"]

[tool.tox]
env_list = [
    "py[[ python_major ]][[ python_minor ]]",
    "py[[ python_major ]][[ python_minor | int - 1 ]]",
    "py[[ python_major ]][[ python_minor | int - 2 ]]",
]

[tool.tox.env_run_base]
commands = [
    ["pytest"],
    ["mypy", "src", "test"],
]
runner = "uv-venv-lock-runner"

[tool.uv]
keyring-provider = "subprocess"
# Fix SSL errors when running in Leash containers
system-certs = true
# Resolve only releases at least 3 days old, so a broken or malicious release
# is usually yanked before a lock refresh picks it up (ADR 013 in
# todofixthis/cookiecutter-py). Exempt one package with
# `exclude-newer-package = { <package> = false }`.
exclude-newer = "3 days"
